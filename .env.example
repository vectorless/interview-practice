# Copy this file to .env and fill in the keys you have.
# Any one provider is enough to start; leave the others blank.
# Changes are picked up on the next request — no restart needed.

# Inference (question generation + interviewer)
ANTHROPIC_API_KEY=

# Speech-to-text and text-to-speech
ELEVENLABS_API_KEY=

# xAI Grok — can do inference, STT and TTS
XAI_API_KEY=
